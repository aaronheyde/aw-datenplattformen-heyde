# Wird von der systemd-Unit (Variante A) oder von Docker-Compose (Variante B) gelesen.
# Keiner dieser Werte ist ein Geheimnis.

# --- Variante A: systemd auf dem Host ---

# Port, auf dem der Express-Server hoert. 3000 ist durch die Zeiterfassung belegt.
PORT=3001

# Adresse, an die der Server bindet. Auf dem Host 127.0.0.1, im Container 0.0.0.0.
HOST=127.0.0.1

NODE_ENV=production

# --- Variante B: Docker mit Traefik ---

# Die Domain, unter der die App erreichbar sein soll. MUSS gesetzt sein und
# per DNS-A-Record auf die IP des VPS zeigen.
APP_DOMAIN=dp.heyde.weise.uk

# Projektname. Bestimmt den Containernamen sowie die Namen von Traefik-Router
# und -Service; muss auf dem Host eindeutig sein.
COMPOSE_PROJECT_NAME=heyde-datenplattformen

# Gemeinsames Netz, in dem Traefik lauscht. Bei Hostinger: traefik-proxy.
TRAEFIK_NETWORK=traefik-proxy

# Name des Zertifikatsanbieters in der Traefik-Konfiguration.
TRAEFIK_CERTRESOLVER=letsencrypt

# Basis-Image, falls der Tag im Ziel-Register anders heisst (z. B. node:24-slim).
NODE_IMAGE=node:24-alpine

APP_VERSION=1.0.0

# Nur fuer deploy/compose.local.yml (lokaler Test ohne Traefik).
BIND_ADDR=127.0.0.1
HOST_PORT=3001
